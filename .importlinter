# Module boundaries for the FastAPI backend (docs/BACKEND.md, rule B1).
# Locked. Package: backend/src/rescuevision_api. One module per database domain
# (database/schema/02-11), plus rescuevision_api.core for shared plumbing.
[importlinter]
root_package = rescuevision_api

[importlinter:contract:layers]
name = Inside every domain: router -> service -> repository, never upward
type = layers
containers =
    rescuevision_api.identity
    rescuevision_api.incidents
    rescuevision_api.imagery
    rescuevision_api.citizens
    rescuevision_api.buildings
    rescuevision_api.roads
    rescuevision_api.cases
    rescuevision_api.hazards
    rescuevision_api.routing
    rescuevision_api.reports
layers =
    router
    service
    repository

[importlinter:contract:identity-public-only]
name = identity uses other domains only through their service module
type = forbidden
source_modules =
    rescuevision_api.identity
forbidden_modules =
    rescuevision_api.incidents.router
    rescuevision_api.incidents.repository
    rescuevision_api.imagery.router
    rescuevision_api.imagery.repository
    rescuevision_api.citizens.router
    rescuevision_api.citizens.repository
    rescuevision_api.buildings.router
    rescuevision_api.buildings.repository
    rescuevision_api.roads.router
    rescuevision_api.roads.repository
    rescuevision_api.cases.router
    rescuevision_api.cases.repository
    rescuevision_api.hazards.router
    rescuevision_api.hazards.repository
    rescuevision_api.routing.router
    rescuevision_api.routing.repository
    rescuevision_api.reports.router
    rescuevision_api.reports.repository

